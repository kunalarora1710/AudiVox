<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1B6BEF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F6F8FC</item>
        <item name="android:navigationBarColor">#F6F8FC</item>
        <item name="android:statusBarColor">#F6F8FC</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7AB1FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#11151C</item>
        <item name="android:navigationBarColor">#11151C</item>
        <item name="android:statusBarColor">#11151C</item>
    </style>
</resources>
